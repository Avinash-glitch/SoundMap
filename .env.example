# Copy to .env (or .env.local for docker compose) and fill in.
# Never commit the filled-in copy — .gitignore already excludes it.

# ---- core -------------------------------------------------------------------
# Signs the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset the app mints a random key per process and logs a warning: sessions
# then reset on every restart.
SESSION_SECRET=generate_a_random_string_here
APP_URL=http://127.0.0.1:8000
PORT=8000

# Host the app redirects legacy URLs to. Leave empty for local runs.
CANONICAL_HOST=
# Extra browser origins allowed to make credentialed cross-site calls,
# comma-separated. The app's own host is always allowed, so this is usually empty.
CORS_ALLOW_ORIGINS=

# Set to 1 to expose /debug/token and /debug/playlists. They hand out the
# logged-in user's Spotify access token, so leave this unset in production.
SOUNDMAP_DEBUG_ROUTES=

# ---- Spotify ----------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# ---- storage ----------------------------------------------------------------
# Without these the app writes maps as JSON under ./user_data (fine locally).
SUPABASE_URL=
SUPABASE_KEY=

# ---- AI providers -----------------------------------------------------------
# Any one is enough. NVIDIA is preferred when its key is present.
NVIDIA_API_KEY=nvapi-...
# Model id on NVIDIA NIM. z-ai/glm-5.1 was retired (HTTP 410).
NVIDIA_MODEL=z-ai/glm-5.3
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ---- Apple Music (MusicKit) -------------------------------------------------
# Team ID and Key ID from the Apple Developer portal.
# Private key: paste the .p8 contents with literal \n in place of real newlines.
APPLE_TEAM_ID=your_team_id_here
APPLE_KEY_ID=your_key_id_here
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----

# ---- optional ---------------------------------------------------------------
SOUNDMAP_NOTIFY_WEBHOOK_URL=
